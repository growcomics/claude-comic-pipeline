{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bakeoff beat sheet",
  "type": "object",
  "required": ["project", "beats"],
  "properties": {
    "project": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "backend": {"enum": ["flow-chrome", "higgsfield-mcp", "flow-manual"]},
    "style": {"type": "string"},
    "beats": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "kind": {"enum": ["panel", "sheet"], "default": "panel"},
          "prompt": {"type": "string", "minLength": 10,
            "description": "ACTION + CAMERA + SETTING only. Appearance lives in refs."},
          "anchors": {"type": "array", "items": {"type": "object", "properties": {
            "board": {"type": "string"}, "local": {"type": "string"},
            "file": {"type": "string"}}}},
          "identityRefs": {"type": "array", "items": {"type": "object", "properties": {
            "char": {"type": "string"},
            "kinds": {"type": "array", "items": {"enum": ["face", "body", "view", "scene", "prop"]}},
            "max": {"type": "integer", "minimum": 1, "maximum": 4},
            "file": {"type": "string"}, "label": {"type": "string"}}}},
          "aspect": {"type": "string", "default": "3:4"},
          "variants": {"type": "integer", "minimum": 2, "maximum": 8, "default": 4}
        }
      }
    }
  }
}
