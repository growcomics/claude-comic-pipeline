# Deny web access to source backups (any *.bak*), bake-off test copies, lint copies, logs, and raw docs.
# App reads data/*.json server-side (filesystem), never over HTTP, so this is safe.
<FilesMatch "(\.bak|-bakeofftest\.php$|_lint\.php$|^error_log$|\.log$|\.md$|\.sha256$)">
  Require all denied
</FilesMatch>
